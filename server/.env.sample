# server env file

# Local API port. Hosting platforms usually inject PORT automatically, so
# leave this unset in production unless the platform tells you otherwise.
# PORT=3000

# Mongo DB
MONGODB_URI="Your_Mongodb_connection uri"

# cloudinary  variables
CLOUDINARY_CLOUD_NAME="Your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# stripe payment variables (test keys by default — see https://docs.stripe.com/keys-best-practices)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Stripe should send the shopper back to after paying. This MUST match
# the client dev origin, because the success/cancel URLs point at the frontend.
CLIENT_URL="http://localhost:5173"

# ---- CORS ----
# The API only accepts browser requests from CLIENT_URL and ADMIN_URL.
ADMIN_URL="http://localhost:5174"
# Optional: override the pair above with a comma-separated allow-list. Use
# this in production so the deployed storefront and admin origins are allowed
# (keep CLIENT_URL for Stripe redirects).
# CORS_ORIGINS="https://shop.example.com,https://admin.example.com"

# ---- Local development ----
# Create .env.local (gitignored) to override values above without editing this
# file. It is loaded before .env; real environment variables still win.
# Example:
#   PORT="3000"
#   CLIENT_URL="http://localhost:5173"
#   ADMIN_URL="http://localhost:5174"
#   CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# ---- Admin panel auth (Auth0) ----
# Must match admin/.env (VITE_AUTH0_DOMAIN / VITE_AUTH0_CLIENTID).
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your_spa_client_id"
# Comma-separated emails bootstrapped as owners on their first sign-in.
SUPER_ADMIN_EMAILS="you@example.com"
# Require Auth0 to report a verified email before matching an allow-list entry.
# Set to "false" only for local dev if your tenant does not verify emails.
AUTH0_REQUIRE_VERIFIED_EMAIL="true"
