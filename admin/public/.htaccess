# SPA fallback for Hostinger (LiteSpeed/Apache).
# Client-side routes such as /logged-out and /ai-assistant must serve
# index.html on refresh or after the Auth0 logout redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
